# Database Configuration
# Railway provides DATABASE_URL automatically when linked
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Moirai Model Configuration
MOIRAI_MODEL=Salesforce/moirai-1.0-R-base
MOIRAI_CONTEXT_LENGTH=100
MOIRAI_PREDICTION_LENGTH=24
MOIRAI_NUM_SAMPLES=100

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
